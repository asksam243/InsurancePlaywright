# Copy this file to .env and fill in real values for your lab environment.
# Never commit the real .env file.

# CONFIRMED defaults for the shared lab VM. Note: the platform's own Setup
# Guide shows `php artisan serve --port=8000` as the generic standalone
# default, but on the combined lab VM (which also hosts FinServe on :8082)
# Insurance Order Entry is actually reverse-proxied on :8081 — use 8081 here,
# not the Setup Guide's 8000, unless you are running this app in true
# standalone isolation outside the shared VM.
BASE_URL=http://localhost:8081
API_BASE_URL=http://localhost:8081

# CONFIRMED: static demo API key required on every /api/* call via the
# X-API-Key header (see utils/apiClient.js for how it's used).
API_KEY=qa-insurance-demo-token-123

# CONFIRMED seeded agent accounts (Setup Guide, Section 11). Default password
# for every fixed account is Password@123.
VALID_AGENT_EMAIL=agent.valid@insurance.test
VALID_AGENT_PASSWORD=Password@123

NEW_AGENT_EMAIL=agent.new@insurance.test
NEW_AGENT_PASSWORD=Password@123

DRAFT_AGENT_EMAIL=agent.draft@insurance.test
DRAFT_AGENT_PASSWORD=Password@123

SUBMITTED_AGENT_EMAIL=agent.submitted@insurance.test
SUBMITTED_AGENT_PASSWORD=Password@123

LOCKED_AGENT_EMAIL=agent.locked@insurance.test
LOCKED_AGENT_PASSWORD=Password@123

MFA_AGENT_EMAIL=agent.mfa@insurance.test
MFA_AGENT_PASSWORD=Password@123

ADMIN_EMAIL=admin@insurance.test
ADMIN_PASSWORD=Password@123

# 30 learner accounts also exist (learner001..learner030@insurance.test, same
# password) — fixtures/users.js's learnerAccount(n) builds these from env vars
# named LEARNER_001_EMAIL / LEARNER_001_PASSWORD etc. if you need to override
# any specific one; otherwise the email pattern + default password is used
# automatically and no entries are needed here.

# Used by TEST_PARALLEL_INDEX-aware fixtures (auth.fixture.js's
# newApplicationId) to pick a distinct learner account per worker and avoid
# draft-state collisions. Playwright sets this automatically when sharding;
# set manually only for local multi-worker runs outside that mechanism.
# TEST_PARALLEL_INDEX=0
