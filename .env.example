# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env file.
# Only INSURANCE_BASE_URL needs checking for the smoke suite to run; everything else already has a confirmed
# default or switches on additional tests (they skip with a clear reason when the variable is empty -
# see README "Run conditions").
#
# Merged from the two earlier projects. The old starter-project names (BASE_URL, API_KEY, VALID_AGENT_EMAIL,
# NEW_AGENT_EMAIL, ...) are still read as fallbacks, so an existing .env keeps working.
# ---------------------------------------------------------------------------

# REQUIRED - Insurance Order Entry app. On the shared lab VM it is reverse-proxied on :8081
# (the Setup Guide's :8000 is only the generic standalone-server default; FinServe lives on :8082).
INSURANCE_BASE_URL=http://<your-lab-vm-ip>:8081
# Optional - defaults to <INSURANCE_BASE_URL>/api  (note: includes /api, unlike the old API_BASE_URL)
INSURANCE_API_URL=
# CONFIRMED: every /api/* call needs a static X-API-Key header. Default is the lab's documented demo key.
INSURANCE_API_KEY=qa-insurance-demo-token-123
# key (default, confirmed) | bearer | session. Whether agent-scoped endpoints also need a per-agent session
# on top of the key is still open (Q03) - switch the mode here, not in code.
API_AUTH_MODE=key

# Seeded agents - CONFIRMED by the platform Setup Guide (section 11). Default password for all of them is Password@123.
AGENT_VALID_EMAIL=agent.valid@insurance.test
AGENT_VALID_PASSWORD=Password@123
AGENT_LOCKED_EMAIL=agent.locked@insurance.test
AGENT_LOCKED_PASSWORD=Password@123
AGENT_INVALID_EMAIL=notreal@insurance.test
AGENT_INVALID_PASSWORD=WrongPassword@1
AGENT_NEW_EMAIL=agent.new@insurance.test
AGENT_NEW_PASSWORD=Password@123
AGENT_MFA_EMAIL=agent.mfa@insurance.test
AGENT_MFA_PASSWORD=Password@123
# agent.draft has an existing draft application
AGENT_DRAFT_EMAIL=agent.draft@insurance.test
AGENT_DRAFT_PASSWORD=Password@123
# agent.submitted has a submitted application
AGENT_SUBMITTED_EMAIL=agent.submitted@insurance.test
AGENT_SUBMITTED_PASSWORD=Password@123
# admin is the only role that lands on /dashboard after login
ADMIN_EMAIL=admin@insurance.test
ADMIN_PASSWORD=Password@123
# Second independent agent for the multi-agent isolation checks (defaults to learner001@insurance.test)
AGENT_SECOND_EMAIL=
AGENT_SECOND_PASSWORD=Password@123
# 30 learner accounts exist (learner001..learner030@insurance.test, same password). env.learnerAccount(n) builds them;
# override one with LEARNER_001_EMAIL / LEARNER_001_PASSWORD etc. if needed.

# NOT confirmed as seeded - leave empty until you have DISPOSABLE accounts for these:
# used ONLY by the five-failed-logins test (it locks the account for DEMO_LOCKOUT_MINUTES, default 30!)
AGENT_LOCKOUT_EMAIL=
AGENT_LOCKOUT_PASSWORD=Password@123
# used ONLY by the password reset / OTP tests
AGENT_RESET_EMAIL=
AGENT_RESET_PASSWORD=Password@123

# Simulated OTP (Q08). Empty = OTP tests skip.
OTP_CODE=

# Business rules. MAX_RIDERS (4) and MAX_UPLOAD_MB (5) are CONFIRMED and default in config/env.js; the rest are still TBC
# (Q07, Q09, Q13-Q17) - empty = dependent tests skip.
FACE_VALUE_DEFAULT=250000
FACE_VALUE_MIN=
FACE_VALUE_MAX=
MAX_RIDERS=4
MAX_UPLOAD_MB=5
SESSION_TIMEOUT_SECONDS=
LOCKOUT_ATTEMPTS=5
AGE_BOUNDARY_INCLUSIVE=true
# Date input format used by the app: iso | us | eu   (iso = yyyy-mm-dd, us = mm/dd/yyyy, eu = dd/mm/yyyy)
DATE_FORMAT=iso

# Optional product / rider name patterns (JS regex source, case-insensitive)
PRODUCT_NAME_PATTERN=whole life
RIDER_ADB_PATTERN=accidental
RIDER_WAIVER_A_PATTERN=
RIDER_WAIVER_B_PATTERN=
RIDER_CRITICAL_ILLNESS_PATTERN=critical
RIDER_AGE_RESTRICTED_PATTERN=
SUITABILITY_PRODUCT_PATTERN=
INELIGIBLE_AGE_PRODUCT_PATTERN=
INELIGIBLE_AGE=

# Defect handling. Comma-separated reported-issue IDs (RI-01..RI-20) that are already LOGGED and approved
# as known defects. Their tests are marked expected-to-fail so the run stays green until the fix lands;
# when the app is fixed the test turns red ("unexpected pass") and the marker must be removed.
EXPECT_FAIL_DEFECTS=

# Shared lab: ONE worker until a stable baseline exists. Raise deliberately (WORKERS=2) and watch for flakiness / collisions.
