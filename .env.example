# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env file.
# Only the variables marked REQUIRED must be set for the smoke suite to run;
# everything else switches on additional tests (they skip with a clear reason
# when the variable is empty - see README "Run conditions").
# ---------------------------------------------------------------------------

# REQUIRED - Insurance Order Entry app (lab VM hosts it on port 8081)
INSURANCE_BASE_URL=http://<your-lab-vm-ip>:8081
# Optional - defaults to <INSURANCE_BASE_URL>/api
INSURANCE_API_URL=
# Optional - sent as X-API-Key when set (placeholder only; get the real value from the Learner Guide)
INSURANCE_API_KEY=
# How the API authenticates after POST /api/auth/login: bearer | session   (Q03 - confirm)
API_AUTH_MODE=bearer

# Seeded agents. valid + locked come from the Learner Guide login example.
AGENT_VALID_EMAIL=agent.valid@insurance.test
AGENT_VALID_PASSWORD=Password@123
AGENT_LOCKED_EMAIL=agent.locked@insurance.test
AGENT_LOCKED_PASSWORD=Password@123
AGENT_INVALID_EMAIL=notreal@insurance.test
AGENT_INVALID_PASSWORD=WrongPassword@1

# Optional seeded users (Q06) - leave empty until the seed list is confirmed
AGENT_NEW_EMAIL=
AGENT_NEW_PASSWORD=Password@123
AGENT_SECOND_EMAIL=
AGENT_SECOND_PASSWORD=Password@123
AGENT_MFA_EMAIL=
AGENT_MFA_PASSWORD=Password@123
# DISPOSABLE agent used ONLY by the five-failed-logins test (it locks the account!)
AGENT_LOCKOUT_EMAIL=
AGENT_LOCKOUT_PASSWORD=Password@123
# DISPOSABLE agent used ONLY by the password reset / OTP tests
AGENT_RESET_EMAIL=
AGENT_RESET_PASSWORD=Password@123

# Simulated OTP (Q08). Empty = OTP tests skip.
OTP_CODE=

# Business rules still marked TBC in Submission 1 (Q07, Q09, Q13-Q17). Empty = dependent tests skip.
FACE_VALUE_DEFAULT=250000
FACE_VALUE_MIN=
FACE_VALUE_MAX=
MAX_RIDERS=
MAX_UPLOAD_MB=
SESSION_TIMEOUT_SECONDS=
LOCKOUT_ATTEMPTS=5
AGE_BOUNDARY_INCLUSIVE=true
# Date input format used by the app: iso | us | eu   (iso = yyyy-mm-dd, us = mm/dd/yyyy, eu = dd/mm/yyyy)
DATE_FORMAT=iso

# Optional product / rider name patterns (JS regex source, case-insensitive)
PRODUCT_NAME_PATTERN=whole life
RIDER_ADB_PATTERN=accidental
RIDER_WAIVER_A_PATTERN=
RIDER_WAIVER_B_PATTERN=
RIDER_CRITICAL_ILLNESS_PATTERN=critical
RIDER_AGE_RESTRICTED_PATTERN=
SUITABILITY_PRODUCT_PATTERN=
INELIGIBLE_AGE_PRODUCT_PATTERN=
INELIGIBLE_AGE=

# Defect handling. Comma-separated reported-issue IDs (RI-01..RI-20) that are already LOGGED and approved
# as known defects. Their tests are marked expected-to-fail so the run stays green until the fix lands;
# when the app is fixed the test turns red ("unexpected pass") and the marker must be removed.
EXPECT_FAIL_DEFECTS=

# Shared lab: ONE worker until a stable baseline exists. Raise deliberately (WORKERS=2) and watch for flakiness / collisions.
WORKERS=1

# Browsers
CROSS_BROWSER=false
# Use an already-installed browser instead of the Playwright download (optional)
BROWSER_CHANNEL=
CHROMIUM_EXECUTABLE_PATH=

# CI toggle: "true" = retries + trace on first retry + limited workers
CI=false
